<?xml version="1.0" encoding="UTF-8"?>
<!--
  Drop this web.config inside your IIS virtual application folder (e.g., E:\IntranetSite\scheduler\web.config).
  Prerequisites on IIS (see deploy/IIS-SETUP.md for full setup steps):
    1. URL Rewrite 2.1 + Application Request Routing (ARR 3.0, with Proxy enabled and responseBufferLimit="0")
    2. IIS Windows Authentication (Web-Windows-Auth) + URL Authorization (Web-Url-Auth) role features installed
    3. Configure Windows Authentication = Enabled and Anonymous Authentication = Disabled on /scheduler
       in IIS Manager or via appcmd (do NOT place <authentication> inside web.config — it is locked by
       default in applicationHost.config and causes HTTP 500.19).
    4. Replace YOURDOMAIN\Analytics-Team below with either:
       - an Active Directory group: YOURDOMAIN\Analytics-Team
       - or a local Windows group on the IIS server: SERVERNAME\Analytics-Team
    5. If mounted under a virtual path other than /scheduler, update the AddTrailingSlash rule below.
    6. Note on X-IIS-User header forwarding: URL Rewrite inbound rules execute in BeginRequest BEFORE
       Windows Authentication populates {LOGON_USER}, so setting HTTP_X_IIS_USER here sends an empty
       header and triggers a 401 loop. See deploy/IIS-SETUP.md Step 4 for forwarding the authenticated
       identity after Windows Auth (PostAuthenticateRequest).
-->
<configuration>
  <system.webServer>
    <security>
      <!-- Requires IIS URL Authorization feature (Web-Url-Auth) -->
      <authorization>
        <remove users="*" roles="" verbs="" />
        <!-- Active Directory group: YOURDOMAIN\Analytics-Team | Local Windows group: SERVERNAME\Analytics-Team -->
        <add accessType="Allow" roles="YOURDOMAIN\Analytics-Team" />
      </authorization>
      <requestFiltering>
        <!-- Match the 1 MB JSON request body limit enforced in scheduler/api.py -->
        <requestLimits maxAllowedContentLength="1048576" />
      </requestFiltering>
    </security>

    <!-- Disable dynamic compression so IIS does not buffer text/event-stream (SSE) live logs -->
    <urlCompression doDynamicCompression="false" />

    <rewrite>
      <rules>
        <!-- Ensure trailing slash on /scheduler so relative ./api/... URLs resolve cleanly.
             Update pattern and redirect URL if mounted under a different virtual path. -->
        <rule name="AddTrailingSlash" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/scheduler$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="/scheduler/" redirectType="Permanent" />
        </rule>

        <!-- Reverse proxy to the local Analytics Scheduler service on 127.0.0.1:8787 -->
        <rule name="ProxyAnalyticsScheduler" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8787/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Preserve upstream 4xx/5xx JSON error responses from the scheduler API instead of IIS HTML error pages.
         Note: This does NOT disable ARR response buffering for SSE; set ARR responseBufferLimit="0" (see IIS-SETUP.md). -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
