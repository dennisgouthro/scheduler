<?xml version="1.0" encoding="UTF-8"?>
<!--
  Drop this web.config inside your IIS virtual application folder (e.g., E:\IntranetSite\scheduler\web.config).
  Prerequisites on IIS:
    1. URL Rewrite 2.1 + Application Request Routing (ARR 3.0, with Proxy enabled)
    2. Windows Authentication enabled on /scheduler (Anonymous Auth disabled)
    3. Allowed server variable "HTTP_X_IIS_USER" added in IIS URL Rewrite -> View Server Variables
    4. Replace YOURDOMAIN\Analytics-Team below with your AD group name
-->
<configuration>
  <system.webServer>
    <security>
      <authentication>
        <anonymousAuthentication enabled="false" />
        <windowsAuthentication enabled="true" />
      </authentication>
      <authorization>
        <remove users="*" roles="" verbs="" />
        <add accessType="Allow" roles="YOURDOMAIN\Analytics-Team" />
      </authorization>
    </security>

    <rewrite>
      <rules>
        <!-- Ensure trailing slash on /scheduler so relative ./api/... URLs resolve cleanly -->
        <rule name="AddTrailingSlash" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/scheduler$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="/scheduler/" redirectType="Permanent" />
        </rule>

        <!-- Reverse proxy to the local Analytics Scheduler service on 127.0.0.1:8787 -->
        <rule name="ProxyAnalyticsScheduler" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_IIS_USER" value="{LOGON_USER}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8787/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Disable response buffering so SSE live logs stream smoothly -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
